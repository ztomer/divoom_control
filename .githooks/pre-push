#!/usr/bin/env bash
# pre-push — runs the FULL gate before anything leaves this machine.
# Installed by gates_of_heck/install.sh. There is no CI behind this; if this
# hook is skipped, it is not run.
set -euo pipefail

GOH="${GOH_DIR:-${GOH:-$HOME/Projects/gates_of_heck}}"
root="$(git rev-parse --show-toplevel)"
gate="$root/tools/gate.sh"

if [ ! -f "$gate" ]; then
    echo "✗ pre-push: $root/tools/gate.sh missing — run '$GOH/install.sh $root'" \
        "to create the starter" >&2
    exit 1
fi

exec bash "$gate" --full
