name: tests

on:
  push:
  pull_request:

jobs:
  no-emoji:
    # House style gate: emoji are a failure state — only the Kare icon set is
    # permitted (tools/check_no_emoji.py). Fast, no build needed.
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.14"
      - name: Check for disallowed emoji
        run: python3 tools/check_no_emoji.py
      - name: Check source files within 500-line house limit
        run: python3 tools/check_file_size.py

  test:
    # macOS so clang builds the dylib and the native (C) encoder tests actually run.
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.14"

      - name: Install PortAudio (pyaudio build dependency)
        # pyaudio has no macOS-arm64 wheel; it builds against Homebrew's
        # PortAudio. Without this the audio-visualizer suite skips.
        run: brew install portaudio

      - name: Install dependencies
        env:
          # Point pyaudio's C build at the Homebrew PortAudio headers/libs.
          CPPFLAGS: -I/opt/homebrew/include
          LDFLAGS: -L/opt/homebrew/lib
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt || true
          pip install pytest pillow pyaudio playwright camoufox

      - name: Install the camoufox browser
        # The GUI e2e suites (15 modules) drive headless camoufox via
        # tests/support/browser.py. Without the binary they now genuinely SKIP
        # (tests/test_e2e_browser_guard.py pins that) — before R66 the
        # importorskip guard only checked the Python module, so a missing
        # browser produced 69 failures that looked like real regressions.
        run: python -m camoufox fetch

      - name: Build native dylib
        run: bash scripts/build_libdivoom.sh

      - uses: dtolnay/rust-toolchain@stable
      - name: Build native divoomd (ble) for the Rust-daemon parity suite
        # Without this, tests/test_rust_daemon_parity.py skips (no binary) so the
        # Rust↔Python parity tests never run in CI. Default features include `ble`.
        run: cargo build -p divoomd --locked

      - name: Run tests (C + Python parity + Rust-daemon parity + GUI e2e + audio)
        run: python3 -m pytest -q

  rust-core:
    # The hardware-/platform-free gate for the native daemon. Builds + tests the
    # protocol/transport core WITHOUT the `ble` feature (no btleplug), on Linux —
    # this is what regressed unnoticed in e4bd424 because no CI ran cargo.
    #
    # R66: runs from the WORKSPACE ROOT, not `working-directory: divoomd`. The
    # old scoping meant divoom-menubar was never formatted, linted, built, or
    # tested by any gate — it had never once been through cargo fmt. fmt/clippy
    # cover every member; --no-default-features stays pinned to `-p divoomd`
    # because the no-BLE core gate is about that crate specifically.
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
        with:
          components: rustfmt, clippy
      - name: No #[allow] in tracked Rust source (house gate)
        run: python3 tools/check_no_allow.py
      - name: Install D-Bus headers
        # clippy --all-features enables `ble` → btleplug → dbus → libdbus-sys,
        # which needs the system dbus-1.pc. Without this the clippy step fails
        # on Ubuntu even though the job is otherwise the no-BLE core gate.
        run: sudo apt-get update && sudo apt-get install -y libdbus-1-dev pkg-config
      - name: cargo fmt --check (whole workspace — no system deps needed)
        run: cargo fmt --all -- --check
      - name: cargo clippy (divoomd, all targets/features, deny warnings)
        # Scoped to divoomd deliberately: this is the LINUX job, and a
        # workspace-wide clippy pulls in divoom-menubar, whose tao/tray-icon
        # deps need GTK/glib. That crate is macOS-only and never ships on
        # Linux, so installing a GTK toolchain here would be buying a
        # dependency to lint a binary this platform does not build.
        # The macOS rust-ble job lints the whole workspace instead.
        run: cargo clippy -p divoomd --all-targets --all-features -- -D warnings
      - name: Build core without BLE
        run: cargo build -p divoomd --no-default-features --locked
      - name: Test core without BLE
        run: cargo test -p divoomd --no-default-features --locked

  rust-ble:
    # Full native daemon build with the `ble` feature (btleplug against
    # CoreBluetooth). macOS so clang builds the libdivoom dylib and the FFI
    # encoder-parity test runs instead of skipping.
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - name: Build native dylib (FFI encoder parity test dependency)
        run: bash scripts/build_libdivoom.sh
      - name: cargo clippy (whole workspace, all targets/features, deny warnings)
        # macOS owns the workspace-wide lint: it is the only platform where
        # divoom-menubar (tao/tray-icon) builds without extra system packages.
        run: cargo clippy --all-targets --all-features -- -D warnings
      - name: Build + test with BLE (whole workspace)
        # Workspace root: this also builds and runs divoom-menubar's tests,
        # which no CI job reached before R66.
        run: cargo test --locked

  rust-ble-linux:
    # Best-effort: prove the btleplug BlueZ backend COMPILES on Linux. No device,
    # no runtime claim (maintainer has no Linux hardware). Non-blocking.
    runs-on: ubuntu-latest
    continue-on-error: true
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - name: Install BlueZ/D-Bus headers (btleplug build dep)
        run: sudo apt-get update && sudo apt-get install -y libdbus-1-dev pkg-config
      - name: Build with BLE (compile-only)
        run: cargo build -p divoomd --features ble --locked
